[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
*.user
*.suo
*.suo
*.ncb
*.sdf
*.opensdf
*.cachefile

# Visual Studio
.vs/
*.vspscc
*.vssscc
*.pidb
*.svclog
*.scc

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.lock.json
!packages.lock.json

# Rider / JetBrains
.idea/
*.sln.iml

# User-specific files
*.rsuser
*.user
*.userosscache
*.sln.docstates

# Test results
TestResults/
[Tt]est[Rr]esult*/
*.trx
*.coveragexml

# Publish output
publish/
**/publish/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Node (if any frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / Secrets
*.env
appsettings.Development.json
appsettings.Local.json
